# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python backend
backend/.venv/
backend/__pycache__/
backend/*.pyc
# local data / index (rebuilt from the user's corpus, not part of this repo)
backend/chroma_db/
backend/text_chunks.tsv
backend/text_chunks.txt
backend/_ingest_tsv.py
# user's own pipeline files live next to server.py but are not part of this repo
backend/rag_chat.py
backend/batch_rag.py
backend/scenario_batch_rag.py
backend/openai_deep_research.py
